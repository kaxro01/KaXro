DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE
GUILD_ID=YOUR_GUILD_ID_HERE

# HeavenCloud current public Lavalink node. The code reads KAXRO_LAVALINK_* to avoid stale panel values.
KAXRO_LAVALINK_HOST=free-lava.heavencloud.in
KAXRO_LAVALINK_PORT=4000
KAXRO_LAVALINK_PASSWORD=heavencloud.in
KAXRO_LAVALINK_SECURE=false
KAXRO_LAVALINK_NAME=KaXro-Lavalink-Public
LAVALINK_SEARCH=ytmsearch

# Optional: set valid IDs only if voice verification is wanted.
VERIFICATION_VOICE_CHANNEL_ID=
VERIFICATION_MEMBER_ROLE_ID=
